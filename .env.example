# PostgreSQL 접속 주소. Spring 로컬 Docker DB와 같은 값이다.
DATABASE_URL=postgresql+psycopg://dodam:dodam_local@127.0.0.1:5433/dodam

# Spring이 AI 서버를 호출할 때 쓰는 내부 토큰. Spring .env의 AI_INTERNAL_TOKEN과 같은 값을 넣는다.
AI_INTERNAL_TOKEN=

# Spring 복지 카탈로그 API
SPRING_BACKEND_BASE_URL=http://localhost:8081
SPRING_BACKEND_TIMEOUT_SECONDS=10

# Spring이 업로드 원본을 저장하는 폴더의 절대 경로.
STORAGE_LOCAL_ROOT=

# GPT-5 설명 생성. 실제 키는 .env에만 두고 Git에 올리지 않습니다.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=low

# PDF 페이지를 이미지로 렌더링할 해상도(DPI). 지정하지 않으면 150.
# DOCUMENT_RENDER_DPI=150

# 문서 한 건에서 처리할 최대 페이지 수. 넘으면 분석을 거절한다. 지정하지 않으면 30.
# DOCUMENT_MAX_PAGES=30

# 페이지 이미지의 긴 변 최대 크기(px). 넘으면 비율을 유지한 채 줄인다. 지정하지 않으면 2048.
# 큰 PDF 페이지나 고화소 사진이 메모리와 VLM 요청 크기를 키우지 않게 막는다.
# DOCUMENT_MAX_PAGE_SIDE_PX=2048

# OpenAI API 키. 문서 페이지에서 항목을 추출(VLM 호출)할 때만 필요하다.
# 비워 두어도 서버와 테스트는 동작하고, 추출을 실행하면 MISSING_API_KEY로 실패한다.
OPENAI_API_KEY=

# 문서 추출에 쓰는 OpenAI 모델. 지정하지 않으면 gpt-5.6-sol.
# OPENAI_VLM_MODEL=gpt-5.6-sol

# 추론 강도. none, low, medium, high, xhigh, max 중 하나. 지정하지 않으면 high.
# 높을수록 느리고 출력 토큰 비용이 늘어난다.
# OPENAI_VLM_REASONING_EFFORT=high

# 페이지 한 장 호출의 출력 토큰 상한. 추론 토큰을 포함한다. 지정하지 않으면 16000.
# 넘으면 그 페이지는 INCOMPLETE로 실패한다.
# OPENAI_VLM_MAX_OUTPUT_TOKENS=16000

# 페이지 한 장 호출의 응답 제한 시간(초). 지정하지 않으면 180.
# OPENAI_VLM_TIMEOUT_SECONDS=180

# OpenAI 서버에 연결할 때까지의 제한 시간(초). 지정하지 않으면 10.
# OPENAI_VLM_CONNECT_TIMEOUT_SECONDS=10

# 페이지 한 장 호출이 시간 초과, 호출 한도 초과(429), 서버·네트워크 오류로 실패했을 때
# 다시 부르는 횟수. 지정하지 않으면 2(처음 호출 포함 최대 3회). 0이면 다시 부르지 않는다.
# OPENAI_VLM_MAX_RETRIES=2

# 첫 재시도 전에 기다리는 시간(초). 재시도마다 두 배가 된다. 지정하지 않으면 1(1초, 2초).
# OPENAI_VLM_RETRY_BACKOFF_SECONDS=1

# 임베딩 API 키. 문서 청크 적재와 RAG 질의 검색에서 벡터를 만들 때만 필요하다.
# OPENAI_API_KEY, LLM_API_KEY로 대체하지 않는다. 비워 두면 임베딩 단계만 MISSING_API_KEY로 실패하고
# 분석 결과는 그대로 남는다.
EMBEDDING_API_KEY=

# 임베딩 모델. 지정하지 않으면 text-embedding-3-small.
# EMBEDDING_MODEL=text-embedding-3-small

# 벡터 차원. 768 고정(DB 컬럼 vector(768)). 다른 값이면 기동할 때 설정 오류가 난다.
# EMBEDDING_DIMENSIONS=768

# 임베딩 요청 한 번의 제한 시간(초). 지정하지 않으면 30.
# EMBEDDING_TIMEOUT_SECONDS=30

# 시간 초과, 호출 한도 초과(429), 서버·네트워크 오류일 때 다시 부르는 횟수.
# 지정하지 않으면 2(처음 호출 포함 최대 3회). 0이면 다시 부르지 않는다.
# EMBEDDING_MAX_RETRIES=2

# 첫 재시도 전에 기다리는 시간(초). 재시도마다 두 배가 된다. 지정하지 않으면 1(1초, 2초).
# EMBEDDING_RETRY_BACKOFF_SECONDS=1

# tiktoken 인코딩 파일(cl100k_base) 캐시 경로. 청킹이 처음 실행될 때 이 파일을 인터넷에서 내려받는다.
# 외부 통신이 막힌 배포 환경에서는 이미지를 빌드할 때 인코딩 파일을 미리 받아 이 경로에 둬야 한다.
# 그렇지 않으면 청킹이 매번 실패하고, 분석 결과는 남지만 문서가 검색되지 않는다.
# 지정하지 않으면 시스템 임시 디렉터리를 쓰므로 컨테이너를 새로 띄울 때마다 다시 내려받는다.
# TIKTOKEN_CACHE_DIR=/app/.tiktoken
